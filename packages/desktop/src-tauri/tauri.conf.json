{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caprice",
  "version": "0.1.0",
  "identifier": "app.caprice.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caprice",
        "width": 190,
        "height": 88,
        "minWidth": 160,
        "minHeight": 72,
        "x": -32000,
        "y": -32000,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "noRedirectionBitmap": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": false,
        "visible": true,
        "focus": false,
        "focusable": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
